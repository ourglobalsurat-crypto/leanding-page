DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional. Comma-separated URL segments the admin panel answers on; every
# other segment, including /admin, gets the ordinary 404. Leave unset to use
# the defaults below. Rotate this if a URL leaks. Never add these to
# robots.txt or link to them from the public site — see the README.
# ADMIN_URL_SLUGS=gsm-admin,fenil-admin

# Required to store or read a lead's phone number and email address — see
# "Lead data encryption" in the README before setting these for real.
# Two DIFFERENT passphrases, each doing a different job: one encrypts the
# field, the other only powers exact-match admin search over it. Losing
# LEAD_ENCRYPTION_PASSPHRASE permanently loses the ability to decrypt every
# lead's phone/email — back it up somewhere durable, not only here.
LEAD_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
LEAD_INDEX_PASSPHRASE=replace-with-a-different-long-random-passphrase

NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_CONTACT_PHONE=+91 99999 99999
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
