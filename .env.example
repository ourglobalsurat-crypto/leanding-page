DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional. Comma-separated URL segments the admin panel answers on; every
# other segment, including /admin, gets the ordinary 404. Leave unset to use
# the defaults below. Rotate this if a URL leaks. Never add these to
# robots.txt or link to them from the public site — see the README.
# ADMIN_URL_SLUGS=gsm-admin,fenil-admin

# Required to store or read a lead's phone number and email address — see
# "Lead data encryption" in the README before setting these for real.
# Two DIFFERENT passphrases, each doing a different job: one encrypts the
# field, the other only powers exact-match admin search over it. Losing
# LEAD_ENCRYPTION_PASSPHRASE permanently loses the ability to decrypt every
# lead's phone/email — back it up somewhere durable, not only here.
LEAD_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
LEAD_INDEX_PASSPHRASE=replace-with-a-different-long-random-passphrase

# Controls what the admin panel's lead export contains. The export is a
# password-protected .xlsx: Excel asks for one of these when the file is
# opened, and which one it is decides what is inside.
#   The plain "Export CSV" button -> invented leads, opens with the DECOY one
#   "Add content" + the REAL one   -> the real, decrypted leads
#   "Add content" + anything else  -> invented leads, and the file opens with
#                                     whatever was typed, so there is no error
# Keep these DIFFERENT from LEAD_ENCRYPTION_PASSPHRASE: these get typed into a
# web form and into Excel's password box, and the encryption key should not.
LEAD_EXPORT_REAL_PASSPHRASE=replace-with-the-passphrase-that-unlocks-real-data
LEAD_EXPORT_DECOY_PASSPHRASE=replace-with-a-different-decoy-passphrase

NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_CONTACT_PHONE=+91 99999 99999
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com


# Both optional. Lead forwarding to the Leadgen CRM works without either: the
# connection link is built into src/lib/crm-lead.ts, because the ?form= token
# is a public write-only form key, not a credential. Set CRM_LEAD_FORM_URL to
# rotate the link without a code change, and CRM_SITE_ORIGIN when the site
# moves to a domain other than the one the CRM has registered.
# CRM_LEAD_FORM_URL=https://leadgen.globalsurat.com/website-form.php?form=ws_xxxxxxxx.yyyyyyyy
# CRM_SITE_ORIGIN=https://global-surat.vercel.app
